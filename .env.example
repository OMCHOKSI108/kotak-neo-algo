# ==============================================================================
# Indian Algo Trading Research Platform - Environment Configuration Template
# ==============================================================================

# Application Configuration
APP_NAME="Indian Algo Trading & Research Platform"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# SAFETY GUARDRAILS (CRITICAL FINANCIAL CONTROLS)
# ------------------------------------------------------------------------------
# Live order execution is disabled by default in V1. Never set to true in production
# without full risk management verification and explicit approval.
TRADING_ENABLED=false

# ------------------------------------------------------------------------------
# SECURITY & ENCRYPTION
# ------------------------------------------------------------------------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-32-byte-base64-fernet-key-here

# JWT Authentication
JWT_SECRET_KEY=generate-a-strong-random-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL connection string: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/algo_trading

# ------------------------------------------------------------------------------
# INITIAL ADMIN BOOTSTRAP CREDENTIALS
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@kotakneoalgo.local
ADMIN_PASSWORD=ChangeMeAdmin@2026!
ADMIN_NAME=Platform Administrator

# ------------------------------------------------------------------------------
# KOTAK NEO TRADE API CREDENTIALS (LATEST OFFICIAL V2/V3 PROTOCOL)
# ------------------------------------------------------------------------------
# Required when connecting a live Kotak Neo account:
# 1. KOTAK_CONSUMER_KEY: The plain access token generated in Kotak Neo app/web
#    (More -> TradeAPI card -> API Dashboard)
# 2. KOTAK_CONSUMER_SECRET: Consumer secret from API Dashboard
# 3. KOTAK_MOBILE_NUMBER: Registered mobile number with +91 or 10 digits
# 4. KOTAK_UCC: Unique Client Code (e.g. ABC87)
# 5. KOTAK_MPIN: 6-digit MPIN for trade validation
# 6. KOTAK_TOTP_SECRET: 32-character TOTP secret key for automatic 2FA code generation
# 7. KOTAK_ENVIRONMENT: 'prod' or 'test'
KOTAK_CONSUMER_KEY=
KOTAK_CONSUMER_SECRET=
KOTAK_MOBILE_NUMBER=
KOTAK_UCC=
KOTAK_MPIN=
KOTAK_TOTP_SECRET=
KOTAK_ENVIRONMENT=prod

# ------------------------------------------------------------------------------
# CORS CONFIGURATION
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
